# Marriage Scorekeeper: installed dependencies and Expo/Metro state
/node_modules/
/.expo/
/expo-env.d.ts
/.metro-health-check*

# Generated by Expo prebuild; app.json and assets/ are the source of truth
/android/
/ios/

# Output from bundle:check, test:coverage, and TypeScript
/dist/
/coverage/
/*.tsbuildinfo

# Local environment and EAS signing credentials
/.env
/.env.*
!/.env.example
/credentials.json
*.jks
*.keystore
*.p8
*.p12
*.pem
*.mobileprovision

# Local release artifacts (published through GitHub Releases)
/*.apk
/*.aab
/*.ipa
/marriage-scorekeeper*.zip

# Ad hoc captures; reviewed screenshots belong in docs/images/
/screenshots/

# npm diagnostics
/npm-debug.log*

# Personal editor state; shared .vscode settings remain trackable
/.vscode/*.local.json
/*.code-workspace

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
