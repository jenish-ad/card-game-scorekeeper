{
  "name": "marriage-scorekeeper",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo-google-fonts/mukta": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.29",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "bundle:check": "expo export --platform android --platform ios",
    "lint:fix": "eslint . --fix",
    "test:coverage": "jest --runInBand --coverage"
  },
  "private": true,
  "engines": {
    "node": ">=22.22 <23"
  },
  "license": "MIT",
  "description": "Offline Marriage card-game scoring, standings, and settlement for Android and iOS.",
  "author": "Griffin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Griffin/REPLACE_WITH_REPOSITORY.git"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "lf"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "<rootDir>/tests/support/transform.cjs"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "src/features/marriage/domain/**/*.ts",
      "src/i18n/calendar/**/*.ts"
    ],
    "coverageThreshold": {
      "./src/features/marriage/domain/": {
        "lines": 90,
        "branches": 90
      },
      "./src/i18n/calendar/": {
        "lines": 90,
        "branches": 90
      }
    }
  }
}
